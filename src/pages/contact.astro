---
import BaseLayout from '../layouts/BaseLayout.astro';
import LocationSection from '../components/LocationSection.astro';
import { pos } from '../lib/z';
---

<BaseLayout
  title="Contact Indra Heritage School for Quality Education | Indra Heritage School"
  description="Get in touch with Indra Heritage School for inquiries about our value-based education, admissions, and more. We are dedicated to providing quality education from nursery to class IX, honoring the legacy of Sh. Indra Deo Dhar Dubey."
  canonicalPath="/contact"
>
  <section>
    <div class="zg" style="--H:778;--mpb:55">
      <div class="z zbox r20" style={`${pos(56, 80, 1111, { h: 640, mt: 58, mh: 320 })};--op:50% 33%;--mop:50% 50%`}>
        <img src="/images/live/20240815-dsc_1082-1-YNqBDQ217VCnkx5e.jpg" alt="Indra Heritage School campus" width="1280" height="852" />
      </div>
    </div>
  </section>

  <LocationSection title="Contact Us" />
</BaseLayout>
