---
import BaseLayout from '../layouts/BaseLayout.astro';
import { galleryTiles } from '../data/gallery';
---

<BaseLayout
  title="Indra Heritage School - Quality Education in Tilaura | Indra Heritage School"
  canonicalPath="/gallery"
>
  <section class="page-hero-title">
    <div class="container">
      <h3>IHS Gallery</h3>
      <p>Explore our vibrant moments of learning and growth at Indra Heritage School</p>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="container">
      <div class="masonry-gallery">
        {
          galleryTiles.map((tile) => (
            <figure class="masonry-gallery__item">
              <img src={tile.src} alt={tile.label || 'Indra Heritage School gallery'} loading="lazy" />
              {tile.label ? <figcaption>{tile.label}</figcaption> : null}
            </figure>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
