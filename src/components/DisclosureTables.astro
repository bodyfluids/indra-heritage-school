---
import { site } from '../../site.config';
const { disclosures } = site;
---

<div class="ihs-table-responsive">
  <table class="ihs-table">
    <thead>
      <tr><th colspan="2">General Information</th></tr>
    </thead>
    <tbody>
      {
        disclosures.general.map((row) => (
          <tr>
            <td class="label">{row.label}</td>
            <td set:html={row.value.replace(/\n/g, '<br />')} />
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<div class="ihs-table-responsive">
  <table class="ihs-table">
    <thead>
      <tr>
        <th>Documents & Information</th>
        <th>Upload / Reference</th>
      </tr>
    </thead>
    <tbody>
      {
        disclosures.documents.map((row) => (
          <tr>
            <td class="label">{row.label}</td>
            <td>
              {row.href ? (
                <a href={row.href} target="_blank" rel="noopener">
                  {row.value}
                </a>
              ) : (
                row.value
              )}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<div class="ihs-table-responsive">
  <table class="ihs-table">
    <thead>
      <tr>
        <th>Infrastructure Information</th>
        <th>Details</th>
      </tr>
    </thead>
    <tbody>
      {
        disclosures.infrastructure.map((row) => (
          <tr>
            <td class="label">{row.label}</td>
            <td>
              {'href' in row && row.href ? (
                <a href={row.href} target="_blank" rel="noopener">
                  {row.value}
                </a>
              ) : (
                <span set:html={String(row.value).replace(/\n/g, '<br />')} />
              )}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<div class="ihs-table-responsive">
  <table class="ihs-table">
    <thead>
      <tr>
        <th>Staff Information</th>
        <th>Details</th>
      </tr>
    </thead>
    <tbody>
      {
        disclosures.staff.map((row) => (
          <tr>
            <td class="label">{row.label}</td>
            <td>
              {'href' in row && row.href ? (
                <a href={row.href} target="_blank" rel="noopener">
                  {row.value}
                </a>
              ) : (
                row.value
              )}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
