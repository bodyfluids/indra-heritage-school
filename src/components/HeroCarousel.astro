---
import { site } from '../../site.config';
const slides = site.heroSlides;
---

<section class="hero" aria-label="Campus photo carousel" data-hero>
  {
    slides.map((src, i) => (
      <div class:list={['hero__slide', { 'is-active': i === 0 }]} data-slide={i}>
        <img src={src} alt="" loading={i === 0 ? 'eager' : 'lazy'} />
      </div>
    ))
  }
  <button type="button" class="hero__arrow hero__arrow--left" data-hero-prev aria-label="Previous slide">
    <svg width="14" height="26" viewBox="0 0 14 26" fill="none" aria-hidden="true"><path d="M1 25L13 13L1 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
  </button>
  <button type="button" class="hero__arrow hero__arrow--right" data-hero-next aria-label="Next slide">
    <svg width="14" height="26" viewBox="0 0 14 26" fill="none" aria-hidden="true"><path d="M1 25L13 13L1 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
  </button>
  <div class="hero__dots">
    {
      slides.map((_, i) => (
        <button
          type="button"
          class:list={{ 'is-active': i === 0 }}
          data-dot={i}
          aria-label={`Go to slide ${i + 1}`}
        />
      ))
    }
  </div>
</section>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-hero]');
    if (!root) return;
    var slides = Array.prototype.slice.call(root.querySelectorAll('[data-slide]'));
    var dots = Array.prototype.slice.call(root.querySelectorAll('[data-dot]'));
    var index = 0;
    var busy = false;
    var timer;

    function go(to, dir) {
      to = (to + slides.length) % slides.length;
      if (busy || to === index) return;
      busy = true;
      var from = slides[index];
      var next = slides[to];
      next.style.transition = 'none';
      next.style.transform = 'translateX(' + dir * 100 + '%)';
      next.classList.add('is-active');
      void next.offsetWidth;
      next.style.transition = '';
      from.style.transform = 'translateX(' + -dir * 100 + '%)';
      next.style.transform = 'translateX(0)';
      dots[index].classList.remove('is-active');
      dots[to].classList.add('is-active');
      index = to;
      window.setTimeout(function () {
        from.classList.remove('is-active');
        from.style.transform = '';
        busy = false;
      }, 600);
    }

    function restart() {
      window.clearInterval(timer);
      timer = window.setInterval(function () { go(index + 1, 1); }, 5000);
    }

    root.querySelector('[data-hero-prev]').addEventListener('click', function () { go(index - 1, -1); restart(); });
    root.querySelector('[data-hero-next]').addEventListener('click', function () { go(index + 1, 1); restart(); });
    dots.forEach(function (dot, n) {
      dot.addEventListener('click', function () { go(n, n > index ? 1 : -1); restart(); });
    });
    restart();
  })();
</script>
