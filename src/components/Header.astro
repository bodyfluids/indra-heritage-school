---
import { site } from '../../site.config';
import SocialIcons from './SocialIcons.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';

function isCurrent(href: string) {
  const h = href.replace(/\/$/, '') || '/';
  return path === h;
}
---

<header class="site-header" id="site-header">
  <div class="site-header__inner">
    <button class="burger" type="button" aria-label="Open menu" aria-expanded="false" id="menu-toggle">
      <span></span><span></span><span></span>
    </button>

    <nav class="site-header__nav" aria-label="Primary">
      {
        site.nav.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <a class="site-header__logo" href="/" aria-label={site.name}>
      <img src="/images/logo.png" alt="Indra Heritage School logo" width="125" height="139" />
    </a>

    <div class="site-header__actions">
      <SocialIcons />
      <a class="btn btn-maroon btn-pill" href={site.applyUrl} target="_blank" rel="noopener">Apply Now</a>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu">
    <nav class="mobile-menu__nav" aria-label="Mobile">
      {
        site.nav.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <SocialIcons />
    <a class="btn btn-maroon btn-pill" href={site.applyUrl} target="_blank" rel="noopener">Apply Now</a>
  </div>
</header>

<script is:inline>
  (function () {
    var header = document.getElementById('site-header');
    var toggle = document.getElementById('menu-toggle');
    var bar = document.querySelector('.announcement');
    if (!header || !toggle) return;
    toggle.addEventListener('click', function () {
      var open = !header.classList.contains('is-open');
      if (open) {
        var used = header.offsetHeight + (bar ? bar.offsetHeight : 0);
        header.style.setProperty('--menu-h', 'calc(100dvh - ' + used + 'px)');
      }
      header.classList.toggle('is-open', open);
      document.body.style.overflow = open ? 'hidden' : '';
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    });
  })();
</script>
