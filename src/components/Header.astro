---
import { site } from '../../site.config';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const primary = site.nav.filter((n) => n.label !== 'Mandatory Disclosures');
const secondary = site.nav.find((n) => n.label === 'Mandatory Disclosures')!;

function isCurrent(href: string) {
  const h = href.replace(/\/$/, '') || '/';
  return path === h;
}
---

<header class="site-header" id="site-header">
  <div class="site-header__inner">
    <button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" id="menu-toggle">
      <span></span><span></span><span></span>
    </button>

    <nav class="site-header__nav" aria-label="Primary">
      {
        primary.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
      <a
        class="nav-secondary"
        href={secondary.href}
        aria-current={isCurrent(secondary.href) ? 'page' : undefined}
      >
        {secondary.label}
      </a>
    </nav>

    <a class="site-header__logo" href="/" aria-label={site.name}>
      <img src="/images/logo.png" alt="Indra Heritage School logo" width="120" height="133" />
    </a>

    <div class="site-header__actions">
      <div class="icon-row">
        <a href={site.facebook} aria-label="Go to Facebook page" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 8.5h2.5V5.5H14c-2.2 0-3.5 1.4-3.5 3.5v1.5H8.5V13H10.5v7h3v-7H16l.5-2.5H13.5V9c0-.3.2-.5.5-.5z"/></svg>
        </a>
        <a href={`mailto:${site.email}`} aria-label="Go to Mail page">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5L4 8V6l8 5 8-5v2z"/></svg>
        </a>
        <a href={`tel:${site.phoneTel}`} aria-label="Go to Tel page">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1.1-.2 1.2.4 2.5.6 3.8.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.7 21 3 13.3 3 3.7c0-.6.4-1 1-1H7.3c.6 0 1 .4 1 1 0 1.3.2 2.6.6 3.8.1.4 0 .8-.3 1.1l-2 2.2z"/></svg>
        </a>
      </div>
      <a class="btn btn-maroon" href={site.applyUrl} target="_blank" rel="noopener">Apply Now</a>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var header = document.getElementById('site-header');
    var toggle = document.getElementById('menu-toggle');
    if (!header || !toggle) return;
    toggle.addEventListener('click', function () {
      var open = header.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  })();
</script>
