---
import { site } from '../../site.config';
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <img class="footer-logo" src="/images/logo-white.png" alt="" width="110" height="122" />
    </div>
    <div>
      <h6>Locate Us</h6>
      <p>{site.address.full}</p>
    </div>
    <div>
      <h6>Contact Us</h6>
      <p>
        Phone: {site.phones[0]}<br />
        Phone: {site.phones[1]}<br />
        Email: <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </div>
    <div>
      <h6>Follow Us</h6>
      <div class="icon-row" style="margin-bottom:16px">
        <a href={site.facebook} aria-label="Go to Facebook page" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true" style="fill:#fff"><path d="M14 8.5h2.5V5.5H14c-2.2 0-3.5 1.4-3.5 3.5v1.5H8.5V13H10.5v7h3v-7H16l.5-2.5H13.5V9c0-.3.2-.5.5-.5z"/></svg>
        </a>
      </div>
      <a class="btn btn-maroon" href={site.applyUrl} target="_blank" rel="noopener">Apply Now</a>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>Copyright © {site.copyrightYears} Indra Heritage School, All Right Reserved.</span>
  </div>
</footer>
