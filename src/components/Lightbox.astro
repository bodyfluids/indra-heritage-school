<script is:inline>
  (function () {
    var groups = document.querySelectorAll('[data-lightbox]');
    if (!groups.length) return;

    function open(srcs, index) {
      var box = document.createElement('div');
      box.className = 'lightbox';
      box.setAttribute('role', 'dialog');
      box.setAttribute('aria-modal', 'true');
      box.innerHTML =
        '<button class="lightbox__button lightbox__button--close" title="Close" aria-label="Close"></button>' +
        '<div class="lightbox__container">' +
        '<div class="lightbox__nav"><button class="lightbox__button lightbox__button--nav lightbox__button--prev" aria-label="Previous image"></button></div>' +
        '<img class="lightbox__image" alt="" />' +
        '<div class="lightbox__nav"><button class="lightbox__button lightbox__button--nav lightbox__button--next" aria-label="Next image"></button></div>' +
        '</div>';
      var img = box.querySelector('.lightbox__image');
      function show(i) {
        index = (i + srcs.length) % srcs.length;
        img.src = srcs[index];
      }
      function close() {
        box.remove();
        document.removeEventListener('keydown', onKey);
      }
      function onKey(e) {
        if (e.key === 'Escape') close();
        else if (e.key === 'ArrowRight') show(index + 1);
        else if (e.key === 'ArrowLeft') show(index - 1);
      }
      box.querySelector('.lightbox__button--close').addEventListener('click', close);
      box.querySelector('.lightbox__button--prev').addEventListener('click', function () { show(index - 1); });
      box.querySelector('.lightbox__button--next').addEventListener('click', function () { show(index + 1); });
      var startX = null;
      img.addEventListener('touchstart', function (e) { startX = e.touches[0].clientX; }, { passive: true });
      img.addEventListener('touchend', function (e) {
        if (startX === null) return;
        var dx = e.changedTouches[0].clientX - startX;
        startX = null;
        if (Math.abs(dx) > 40) show(index + (dx < 0 ? 1 : -1));
      });
      document.addEventListener('keydown', onKey);
      show(index);
      document.body.appendChild(box);
    }

    groups.forEach(function (group) {
      group.addEventListener('click', function (e) {
        var item = e.target.closest('[data-lb]');
        if (!item) return;
        var items = Array.prototype.slice.call(group.querySelectorAll('[data-lb]'))
          .filter(function (el) { return el.offsetParent !== null; })
          .sort(function (a, b) { return a.dataset.lb - b.dataset.lb; });
        var srcs = items.map(function (el) { return el.dataset.lbSrc; });
        open(srcs, items.indexOf(item));
      });
    });
  })();
</script>
