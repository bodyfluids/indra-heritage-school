---
import MapEmbed from './MapEmbed.astro';
import { site } from '../../site.config';
import { pos } from '../lib/z';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section class="home-location">
  <div class="zg" style="--H:608;--mpb:41">
    <h4 class="z location-title" style={pos(0, 120, 503, { mt: 40 })}>{title}</h4>
    <p class="z location-text" style={pos(0, 214, 503, { mt: 22 })}>
      <strong>Indra Heritage School</strong><br />
      {site.address.line1}<br />
      {site.address.line2}<br /><br />
      <strong>Hours</strong><br />
      Monday - Saturday<br />
      9am - 6pm<br /><br />
      <strong>Contacts</strong><br />
      {site.phones[0]} or {site.phones[1]}<br />
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </p>
    <div class="z location-map" style={pos(515, 80, 709, { mt: 40 })}>
      <MapEmbed />
    </div>
  </div>
</section>
