---
import { site } from '../../site.config';

interface Props {
  class?: string;
  only?: 'facebook';
}

const { class: className, only } = Astro.props;
---

<div class:list={['icon-row', className]}>
  <a href={site.facebook} aria-label="Go to Facebook page" target="_blank" rel="noopener">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.0726C24 5.44354 18.629 0.0725708 12 0.0725708C5.37097 0.0725708 0 5.44354 0 12.0726C0 18.0619 4.38823 23.0264 10.125 23.9274V15.5414H7.07661V12.0726H10.125V9.4287C10.125 6.42144 11.9153 4.76031 14.6574 4.76031C15.9706 4.76031 17.3439 4.99451 17.3439 4.99451V7.94612H15.8303C14.34 7.94612 13.875 8.87128 13.875 9.82015V12.0726H17.2031L16.6708 15.5414H13.875V23.9274C19.6118 23.0264 24 18.0619 24 12.0726Z"></path></svg>
  </a>
  {
    !only && (
      <>
        <a href={`mailto:${site.email}`} aria-label="Go to Mail page">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.75 3H2.25C1.00734 3 0 4.00734 0 5.25V18.75C0 19.9927 1.00734 21 2.25 21H21.75C22.9927 21 24 19.9927 24 18.75V5.25C24 4.00734 22.9927 3 21.75 3ZM21.75 5.25V7.16273C20.699 8.01862 19.0234 9.3495 15.4412 12.1545C14.6518 12.7754 13.0881 14.2672 12 14.2498C10.9121 14.2674 9.34786 12.7752 8.55877 12.1545C4.97719 9.34992 3.30117 8.01877 2.25 7.16273V5.25H21.75ZM2.25 18.75V10.0499C3.32409 10.9054 4.8473 12.1059 7.16897 13.9239C8.19352 14.7304 9.98775 16.5108 12 16.5C14.0024 16.5108 15.7739 14.7563 16.8306 13.9243C19.1522 12.1064 20.6759 10.9055 21.75 10.05V18.75H2.25Z"></path></svg>
        </a>
        <a href={`tel:${site.phoneTel}`} aria-label="Go to Tel page">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.3156 16.9592L18.0655 14.7092C17.8412 14.6136 17.5919 14.5935 17.3552 14.6518C17.1185 14.7101 16.9071 14.8438 16.7529 15.0326L14.4279 17.8733C10.779 16.1529 7.84242 13.2163 6.12198 9.5674L8.96266 7.24236C9.15188 7.08845 9.28581 6.87709 9.34418 6.64026C9.40254 6.40343 9.38215 6.15404 9.2861 5.92983L7.03606 0.679743C6.93064 0.438055 6.7442 0.240725 6.50887 0.12178C6.27355 0.00283371 6.00409 -0.0302726 5.74697 0.0281692L0.87189 1.15319C0.623996 1.21043 0.402825 1.35001 0.244474 1.54914C0.0861227 1.74827 -5.71046e-05 1.9952 2.8389e-08 2.24961C2.8389e-08 14.2733 9.74548 24 21.7504 24C22.0049 24.0002 22.2519 23.914 22.4511 23.7557C22.6504 23.5973 22.79 23.3761 22.8473 23.1281L23.9723 18.253C24.0304 17.9946 23.9965 17.7241 23.8767 17.488C23.7568 17.2518 23.5584 17.0649 23.3156 16.9592Z"></path></svg>
        </a>
      </>
    )
  }
</div>
